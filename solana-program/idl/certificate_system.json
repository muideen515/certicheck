{
  "version": "0.1.0",
  "name": "certi_check",
  "instructions": [
    {
      "name": "initializeIssuer",
      "accounts": [
        { "name": "issuer", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "name", "type": "string" },
        { "name": "uri", "type": "string" }
      ]
    },
    {
      "name": "issueCertificate",
      "accounts": [
        { "name": "issuer", "isMut": false, "isSigner": false },
        { "name": "holder", "isMut": false, "isSigner": false },
        { "name": "certificate", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "certId", "type": "string" },
        { "name": "holderName", "type": "string" },
        { "name": "certType", "type": "string" },
        { "name": "metadataUri", "type": "string" },
        { "name": "metadataHash", "type": "string" }
      ]
    },
    {
      "name": "revokeCertificate",
      "accounts": [
        { "name": "certificate", "isMut": true, "isSigner": false },
        { "name": "issuer", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true }
      ],
      "args": [
        { "name": "reason", "type": "string" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "issuerProfile",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "metadataUri", "type": "string" },
          { "name": "certCount", "type": "u64" },
          { "name": "isActive", "type": "bool" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "certificateAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "issuer", "type": "publicKey" },
          { "name": "holder", "type": "publicKey" },
          { "name": "certId", "type": "string" },
          { "name": "holderName", "type": "string" },
          { "name": "certType", "type": "string" },
          { "name": "metadataUri", "type": "string" },
          { "name": "metadataHash", "type": "string" },
          { "name": "isRevoked", "type": "bool" },
          { "name": "revokeReason", "type": "string" },
          { "name": "issuedAt", "type": "i64" },
          { "name": "revokedAt", "type": { "option": "i64" } },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ]
}
