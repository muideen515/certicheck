# Local development env (placeholders) — copy from .env.example and fill with real values
# DO NOT commit secrets to the repository

PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=certicheck

# JWT
JWT_SECRET=your_jwt_secret_here

# IPFS / Pinata
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./solana-keypair.json
SOLANA_PAYER_SECRET=

# Email
EMAIL_API_KEY=

# Local store (optional)
CERTIFICATE_STORE_FILE=
DEMO_MODE=false
