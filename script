      </div>
    `).join('');
  } catch (e) {
    listEl.innerHTML = '<div>Error loading certificates.</div>';
  }
}

// QR scanner using Html5Qrcode
let _html5QrcodeScanner = null;
async function startQrScanner() {
  // create scanner container if missing
  let scannerRoot = document.getElementById('qrScanner');
  if (!scannerRoot) {
    scannerRoot = document.createElement('div');
    scannerRoot.id = 'qrScanner';
    scannerRoot.style.position = 'fixed';
    scannerRoot.style.left = '50%';
    scannerRoot.style.top = '20%';
    scannerRoot.style.transform = 'translateX(-50%)';
    scannerRoot.style.zIndex = '9999';
    scannerRoot.style.background = 'white';
    scannerRoot.style.padding = '12px';
    scannerRoot.style.borderRadius = '8px';
    scannerRoot.style.boxShadow = '0 8px 30px rgba(0,0,0,0.12)';
    document.body.appendChild(scannerRoot);
  }

  scannerRoot.innerHTML = '<div id="qrScannerRegion" style="width:320px;height:260px"></div><div style="margin-top:8px;text-align:right"><button id="qrCancelBtn" class="btn-ghost">Cancel</button></div>';

  const regionId = 'qrScannerRegion';
  const html5Qr = new Html5Qrcode(regionId);
  _html5QrcodeScanner = html5Qr;

  const config = { fps: 10, qrbox: { width: 260, height: 200 } };

  const onScanSuccess = (decodedText, decodedResult) => {
    try {
      // stop scanner
      html5Qr.stop().then(() => {
        document.getElementById('qrScanner')?.remove();
        _html5QrcodeScanner = null;
      }).catch(() => {});

      // populate input and verify
      const input = document.getElementById('certIdInput');
      if (input) {
        input.value = decodedText;
        verifyCertificate();
      }
    } catch (e) {
      console.warn('QR scan handler error', e);
    }
  };

  const onScanFailure = (error) => {
    // console.debug('QR scan failure', error);
  };

  html5Qr.start({ facingMode: 'environment' }, config, onScanSuccess, onScanFailure).catch(err => {
    console.warn('Unable to start QR scanner:', err);
    document.getElementById('qrScanner')?.remove();
  });

  document.getElementById('qrCancelBtn')?.addEventListener('click', () => {
    if (_html5QrcodeScanner) {
      _html5QrcodeScanner.stop().finally(() => {
        document.getElementById('qrScanner')?.remove();
        _html5QrcodeScanner = null;
      });
    } else {
      document.getElementById('qrScanner')?.remove();
    }
  });
}

function applyTheme(theme) {
  const body = document.body;
  const toggle = document.getElementById("themeToggle");

  if (theme === "dark") {
    body.classList.add("dark");
    if (toggle) toggle.title = "Switch to light mode";
  } else {
    body.classList.remove("dark");
    if (toggle) toggle.title = "Switch to dark mode";
  }
}

